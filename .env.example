NUXT_PUBLIC_APP_URL=http://localhost:3000
# Ao trocar o tunel ngrok, atualize tambem vite.server.allowedHosts em nuxt.config.ts.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
# Apenas no servidor. Nunca use prefixo NUXT_PUBLIC_ nesta variável.

NUXT_SUPABASE_SECRET_KEY=

# Compatibilidade temporária para cobranças Pix criadas antes da migração.
NUXT_ASAAS_API_KEY=
NUXT_ASAAS_API_URL=https://api-sandbox.asaas.com/v3
NUXT_ASAAS_WEBHOOK_TOKEN=

# Credenciais ativas do Mercado Pago (Access Token somente no servidor).
NUXT_MERCADO_PAGO_ACCESS_TOKEN=
NUXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
NUXT_MERCADO_PAGO_WEBHOOK_SECRET=
NUXT_MERCADO_PAGO_WEBHOOK_URL=
# Credenciais separadas de teste; usadas exclusivamente pelo simulador administrativo.
NUXT_MERCADO_PAGO_TEST_ACCESS_TOKEN=
NUXT_PUBLIC_MERCADO_PAGO_TEST_PUBLIC_KEY=
# Tarifas opcionais repassadas ao aluno. Configure conforme sua conta Mercado Pago.
NUXT_MERCADO_PAGO_PIX_PERCENT=0
NUXT_MERCADO_PAGO_PIX_FIXED=0
NUXT_PAYMENT_SERVICE_FEE=0
NUXT_REGISTRATION_DATA_KEY=
NUXT_NOTIFICATION_WEBHOOK_URL=
NUXT_NOTIFICATION_WEBHOOK_TOKEN=

NUXT_SMTP_HOST=smtppro.zoho.com
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=

E2E_COURSE_ID=
E2E_COURSE_SLUG=
E2E_COURSE_TITLE=
E2E_INSTRUCTOR_ID=

# Proteções obrigatórias para scripts/e2e/*; configure somente no ambiente local/CI DEV.
E2E_SUPABASE_ENV=
E2E_SUPABASE_DEV_HOST=

NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
NUXT_SMTP_SECURE=

NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
